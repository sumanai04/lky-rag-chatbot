# DeepSeek chat model, accessed through an OpenAI-compatible endpoint.
# Copy this file to .env and fill in the values. Never commit .env.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://your-endpoint.example.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Generation and retrieval settings
TEMPERATURE=0.3
TOP_K=8
CHUNK_SIZE=600
CHUNK_OVERLAP=100
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_POOL_SIZE=300
QUERY_EXPANSION=true
